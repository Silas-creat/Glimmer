test('EDGE-R3-01 a late clear success for A cannot wipe B page or announce B cleared', async () => {
  const deletion = deferred();
  const s = setup((url, optionsArg) => {
    if (url === '/ai/memory' && optionsArg.method === 'DELETE') return deletion.promise;
    if (url === '/ai/chat') return chatSuccess('B fresh reply');
    return { code: 0, data: {} };
  });
  await s.action('clear');
