  let posts = 0;
  const s = setup((url, optionsArg) => {
    if (url === '/companion/prepare') {
      return { code: 0, data: { draft: { id: 'normal', date: '2026-11-13', text: 'body', status: 'pending', sources: [] }, trace: [] } };
    }
    if (url.endsWith('/confirm')) {
      posts += 1;
      return { code: 0, data: { diaryId: 7, date: '2026-11-13', url: 'diary-write.html?date=2026-11-13', status: 'confirmed', isPublic: false, care: null } };
    }
    return { code: 0, data: {} };
  });
  await s.action('draft');
  s.ui.state.turns = [{ role: 'user', content: 'material' }];
  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];
  await s.ui.prepareDraft(new El('button'), { value: '2026-11-13' }, { checked: false }, new El('p'));
  await s.ui.confirmDraft(s.findButton('确认保存为私密日记'), new El('p'), { value: 'body' });
  assert.equal(posts, 1);
  assert.match(s.nodes['cc-panel-body'].textContent, /7/);
});
test('EDGE-R1-01 draft material is bound to the selecting account before prepare', async () => {
  const s = setup(url => {
    if (url === '/companion/prepare') {
      return { code: 0, data: { draft: { id: 'a-draft', date: '2026-11-13', text: 'A private draft text', status: 'pending', sources: [] } } };
    }
    return { code: 0, data: {} };
  });
  await s.action('draft');
  s.ui.state.turns = [{ role: 'user', content: 'A private material' }];
  s.ui.renderDraftSelection();
  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];

  s.setAccount({ uid: 'B' }, 'token-B');
  await s.findButton('生成草稿').onclick();
  await flush();

  assert.equal(s.calls.filter(call => call.url === '/companion/prepare').length, 0);
  assert.equal(s.ui.state.uid, 'B');
  assert.doesNotMatch(s.nodes.chat.textContent, /A private material/);
  assert.doesNotMatch(s.nodes['cc-panel-body'].textContent, /A private material/);
  assert.match(s.nodes['cc-save-state'].textContent, /账号或登录状态已变化/);
});

test('EDGE-R1-02 same-account token refresh still prepares exactly once', async () => {
  const s = setup(url => {
    if (url === '/auth/me') return { code: 0, data: { user: { uid: 'A' } } };
    if (url === '/companion/prepare') {
      return { code: 0, data: { draft: { id: 'refresh-draft', date: '2026-11-13', text: 'refreshed', status: 'pending', sources: [] } } };
    }
    return { code: 0, data: {} };
  });
  await s.action('draft');
  s.ui.state.turns = [{ role: 'user', content: 'A material' }];
  s.ui.renderDraftSelection();
  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];

  s.setAccount({ uid: 'A' }, 'token-A2');
  await s.findButton('生成草稿').onclick();
  await flush();

  const prepares = s.calls.filter(call => call.url === '/companion/prepare');
  assert.equal(prepares.length, 1);
  assert.equal(prepares[0].body.message, 'A material');
});

test('EDGE-R1-03 confirm does not submit A draft after credentials switch to B without storage', async () => {
  const s = setup(url => {
    if (url === '/companion/prepare') {
      return { code: 0, data: { draft: { id: 'bound-draft', date: '2026-11-13', text: 'body', status: 'pending', sources: [] } } };
    }
    if (url.endsWith('/confirm')) {
      return { code: 0, data: { diaryId: 9, date: '2026-11-13', url: 'diary-write.html?date=2026-11-13', isPublic: false, care: null } };
    }
    return { code: 0, data: {} };
  });
  await s.action('draft');
  s.ui.state.turns = [{ role: 'user', content: 'A material' }];
  s.ui.renderDraftSelection();
  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];
  await s.findButton('生成草稿').onclick();
  await flush();

  s.setAccount({ uid: 'B' }, 'token-B');
  await s.findButton('确认保存为私密日记').onclick();
  await flush();

  assert.equal(s.calls.filter(call => call.url.endsWith('/confirm')).length, 0);
  assert.doesNotMatch(s.nodes['cc-panel-body'].textContent, /已保存为私密日记/);
  assert.match(s.nodes['cc-save-state'].textContent, /账号或登录状态已变化/);
});

