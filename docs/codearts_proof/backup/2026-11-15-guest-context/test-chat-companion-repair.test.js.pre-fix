});

test('EDGE-R3-02 closing the clear panel still clears the same account context', async () => {
  const deletion = deferred();
  const s = setup((url, optionsArg) => {
    if (url === '/ai/memory' && optionsArg.method === 'DELETE') return deletion.promise;
    if (url === '/ai/memory') return { code: 0, data: { hasMemory: true, summary: 'own summary', totalMessages: 1 } };
    if (url === '/ai/chat') return chatSuccess('reply');
    return { code: 0, data: {} };
  });
  s.nodes.input.value = 'own context';
  await s.nodes['send'].emit('click');
  await flush();
  await s.action('memory');
  await flush();
  assert.ok(s.ui.state.memorySnapshot);

  await s.action('clear');
  const clearing = s.findButton('确认清除').onclick();
  s.ui.closePanel();
  deletion.resolve({ code: 0, data: { deleted: 1 } });
  await clearing;
  await flush();

  assert.equal(s.ui.state.turns.length, 0);
  assert.equal(s.ui.state.memorySnapshot, null);
  assert.doesNotMatch(s.nodes['cc-panel-body'].textContent, /已清除 1/);
});

test('EDGE-R3-03 a late clear failure for A cannot show on B page', async () => {
