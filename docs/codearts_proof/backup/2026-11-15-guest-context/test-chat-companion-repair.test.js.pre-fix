test('EDGE-R4-01 an obsolete send cannot unlock a newer pending send', async () => {
  const oldSend = deferred();
  const newSend = deferred();
  let chatCount = 0;
  const s = setup((url, optionsArg) => {
    if (url === '/ai/chat') {
      chatCount += 1;
      return chatCount === 1 ? oldSend.promise : newSend.promise;
    }
    if (url === '/ai/memory' && optionsArg.method === 'DELETE') return { code: 0, data: { deleted: 0 } };
    return { code: 0, data: {} };
  });
  s.nodes.input.value = 'old';
  const oldPending = s.nodes['send'].emit('click');
  await flush();

  await s.action('clear');
  await s.findButton('确认清除').onclick();

  s.nodes.input.value = 'new pending';
  const newPending = s.nodes['send'].emit('click');
  await flush();
  assert.equal(s.ui.state.sending, true);
  const turnsBefore = s.ui.state.turns.length;

  oldSend.resolve(chatSuccess('old reply'));
  await oldPending;
  await flush();

  assert.equal(s.ui.state.sending, true);
  assert.equal(s.nodes['send'].disabled, true);
  assert.equal(s.ui.state.turns.length, turnsBefore);

  s.nodes.input.value = 'third message';
  const third = s.nodes['send'].emit('click');
  await flush();
  assert.equal(chatCount, 2);
  assert.equal(s.ui.state.turns.length, turnsBefore);

  newSend.resolve(chatSuccess('new reply'));
  await newPending;
  await third;
});

test('EDGE-R4-02 double click during identity verification sends only once', async () => {
  const me = deferred();
  let chatCount = 0;
  const s = setup(url => {
    if (url === '/auth/me') return me.promise;
    if (url === '/ai/chat') { chatCount += 1; return chatSuccess('reply'); }
    return { code: 0, data: {} };
  });
  s.setAccount({ uid: 'A' }, 'token-A2');
  s.nodes.input.value = 'double click';
  const first = s.nodes['send'].emit('click');
  const second = s.nodes['send'].emit('click');
  await flush();
  me.resolve({ code: 0, data: { user: { uid: 'A' } } });
  await Promise.all([first, second]);
  await flush();

  assert.equal(chatCount, 1);
  assert.equal(s.ui.state.turns.filter(turn => turn.role === 'user').length, 1);
});

test('EDGE-R4-03 a late send failure for A cannot overwrite B input or notice', async () => {
  const reply = deferred();
  const s = setup(url => {
    if (url === '/ai/chat') return reply.promise;
    return { code: 0, data: {} };
  });
  s.nodes.input.value = 'A message';
