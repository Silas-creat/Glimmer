test('EDGE-R2-01 memory opened during pending clear cannot restore the cleared summary', async () => {
  const deletion = deferred();
  const memory = deferred();
  const s = setup((url, optionsArg) => {
    if (url === '/ai/memory' && optionsArg.method === 'DELETE') return deletion.promise;
    if (url === '/ai/memory') return memory.promise;
    return { code: 0, data: {} };
  });
  await s.action('clear');
  const clearing = s.findButton('确认清除').onclick();
  s.ui.closePanel();
  await s.action('memory');
  deletion.resolve({ code: 0, data: { deleted: 2 } });
  await clearing;
  memory.resolve({ code: 0, data: { hasMemory: true, summary: 'old cleared summary', totalMessages: 2, pendingMessages: 0 } });
  await flush();

  assert.equal(s.ui.state.memorySnapshot, null);
  assert.doesNotMatch(s.nodes['cc-panel-body'].textContent, /old cleared summary/);
  assert.match(s.nodes['cc-panel-body'].textContent, /还没有聊天记录。/);
});

test('EDGE-R2-02 a successful clear invalidates an already rendered old summary', async () => {
  const deletion = deferred();
  const s = setup((url, optionsArg) => {
    if (url === '/ai/memory' && optionsArg.method === 'DELETE') return deletion.promise;
    if (url === '/ai/memory') return { code: 0, data: { hasMemory: true, summary: 'pre-clear summary', totalMessages: 2, pendingMessages: 0 } };
    return { code: 0, data: {} };
  });
  await s.action('clear');
  const clearing = s.findButton('确认清除').onclick();
  s.ui.closePanel();
  await s.action('memory');
  await flush();
  assert.match(s.nodes['cc-panel-body'].textContent, /pre-clear summary/);

  deletion.resolve({ code: 0, data: { deleted: 2 } });
  await clearing;
  await flush();

  assert.equal(s.ui.state.memorySnapshot, null);
  assert.doesNotMatch(s.nodes['cc-panel-body'].textContent, /pre-clear summary/);
  assert.equal(s.ui.state.historyPage, 1);
  assert.equal(s.ui.state.historyHasMore, false);
});

test('EDGE-R2-03 a successful clear leaves an open draft editor untouched', async () => {
  const deletion = deferred();
