import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import vm from 'node:vm';
import path from 'node:path';
import { createRequire } from 'node:module';
import { fileURLToPath } from 'node:url';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../前端参考') + path.sep;
const require = createRequire(import.meta.url);
const companion = require('../../前端参考/chat-companion.js');

class El {
  constructor(tag = 'div') {
    this.tag = tag;
    this.children = [];
    this.events = {};
    this.attrs = {};
    this.hidden = false;
    this.disabled = false;
    this.checked = false;
    this.value = '';
    this.text = '';
    this.href = '';
    this.type = '';
    this.onclick = null;
    this.scrollTop = 0;
    this.scrollHeight = 0;
  }
  set textContent(value) { this.text = String(value); this.children = []; }
  get textContent() { return (this.text || '') + this.children.map(child => child.textContent).join(''); }
  appendChild(child) { this.children.push(child); child.parent = this; return child; }
  replaceChildren(...children) { this.text = ''; this.children = children; children.forEach(child => { child.parent = this; }); }
  remove() { if (this.parent) this.parent.children = this.parent.children.filter(child => child !== this); }
  focus() {}
  setAttribute(key, value) { this.attrs[key] = String(value); }
  getAttribute(key) { return this.attrs[key]; }
  addEventListener(type, handler) { (this.events[type] ||= []).push(handler); }
  closest() { return this; }
  querySelectorAll() { return []; }
  emit(type, event = {}) { return Promise.all((this.events[type] || []).map(handler => handler(event))); }
}

function deferred() {
  let resolve;
  const promise = new Promise(done => { resolve = done; });
  return { promise, resolve };
}

async function flush() {
  for (let i = 0; i < 10; i += 1) await Promise.resolve();
}

function setup(request, options = {}) {
  const ids = [
    'chat', 'input', 'send', 'model-status', 'care', 'cc-mode-note',
    'cc-save-toggle', 'cc-save-state', 'cc-save-hint', 'cc-tools',
    'cc-panel', 'cc-panel-title', 'cc-panel-body', 'cc-panel-close',
  ];
  const nodes = Object.fromEntries(ids.map(id => [id, new El()]));
  nodes['cc-panel'].hidden = true;

  const storage = new Map(options.saved ? [['wg_ai_save_mode_A', 'on']] : []);
  let user = options.user || { uid: 'A' };
  let token = options.token === undefined ? 'token-A' : options.token;
  const storageListeners = [];
  const calls = [];

  const ctx = vm.createContext({
    console,
    document: {
      createElement: tag => new El(tag),
      getElementById: id => nodes[id],
      activeElement: null,
      addEventListener() {},
    },
    localStorage: {
      getItem: key => (storage.has(key) ? storage.get(key) : null),
      setItem: (key, value) => storage.set(key, String(value)),
    },
    getToken: () => token,
    getUser: () => user,
    setUser: next => { user = next; },
    addEventListener: (type, handler) => { if (type === 'storage') storageListeners.push(handler); },
  });

  for (const file of ['chat-session.js', 'chat-companion.js']) {
    vm.runInContext(fs.readFileSync(ROOT + file, 'utf8'), ctx, { filename: file });
  }

  const api = async (url, optionsArg = {}) => {
    calls.push({ url, method: optionsArg.method || 'GET', body: optionsArg.body });
    if (url === '/ai/status') return { code: 0, data: { isReal: false } };
    return request(url, optionsArg);
  };
  const ui = ctx.ChatCompanion.mountChatCompanion({ api });

  const action = async name => {
    const target = new El();
    target.setAttribute('data-cc-action', name);
    await nodes['cc-tools'].emit('click', { target });
  };
  const buttons = () => {
    const all = [];
    const visit = node => {
      if (node.tag === 'button') all.push(node);
      node.children.forEach(visit);
    };
    visit(nodes['cc-panel-body']);
    return all;
  };
  const findButton = text => buttons().find(node => node.textContent === text);
  const setAccount = (nextUser, nextToken) => { user = nextUser; token = nextToken; };
  const emitStorage = key => storageListeners.forEach(handler => handler({ key }));

  return { ctx, nodes, ui, storage, calls, action, buttons, findButton, setAccount, emitStorage };
}

const chatSuccess = content => ({ code: 0, data: { reply: { content }, saved: true, provider: { isReal: false } } });
const historyEmpty = { code: 0, data: { list: [], hasMore: false } };

test('P1-01 closing save during /auth/me keeps the user choice temporary', async () => {
  const verify = deferred();
  const s = setup(url => {
    if (url === '/auth/me') return verify.promise;
    if (url === '/ai/messages') return historyEmpty;
    return { code: 0, data: {} };
  });

  s.nodes['cc-save-toggle'].checked = true;
  const enabling = s.nodes['cc-save-toggle'].emit('change');
  s.nodes['cc-save-toggle'].checked = false;
  await s.nodes['cc-save-toggle'].emit('change');
  assert.equal(s.ui.state.mode, 'temporary');
  assert.notEqual(s.storage.get('wg_ai_save_mode_A'), 'on');

  verify.resolve({ code: 0, data: { user: { uid: 'A' } } });
  await enabling;
  await flush();
  assert.equal(s.ui.state.mode, 'temporary');
  assert.equal(s.nodes['cc-save-toggle'].checked, false);
  assert.equal(s.calls.some(call => call.url === '/ai/messages'), false);
});

test('P1-02 initial preference restore loses to a later explicit close', async () => {
  const verify = deferred();
  const s = setup(url => {
    if (url === '/auth/me') return verify.promise;
    if (url === '/ai/messages') return historyEmpty;
    return { code: 0, data: {} };
  }, { saved: true });

  s.nodes['cc-save-toggle'].checked = false;
  await s.nodes['cc-save-toggle'].emit('change');
  verify.resolve({ code: 0, data: { user: { uid: 'A' } } });
  await flush();
  assert.equal(s.ui.state.mode, 'temporary');
  assert.notEqual(s.storage.get('wg_ai_save_mode_A'), 'on');
});

test('P1-03 a late auth response for another account does not grant save', async () => {
  const verify = deferred();
  const s = setup(url => {
    if (url === '/auth/me') return verify.promise;
    return { code: 0, data: {} };
  });

  s.nodes['cc-save-toggle'].checked = true;
  const enabling = s.nodes['cc-save-toggle'].emit('change');
  s.setAccount({ uid: 'B' }, 'token-B');
  verify.resolve({ code: 0, data: { user: { uid: 'B' } } });
  await enabling;
  await flush();
  assert.equal(s.ui.state.mode, 'temporary');
  assert.equal(s.ui.state.uid, 'B');
  assert.notEqual(s.storage.get('wg_ai_save_mode_B'), 'on');
});

test('P1-04 a reply arriving after clear never re-enters the next temporary request', async () => {
  const reply = deferred();
  const bodies = [];
  const s = setup((url, optionsArg) => {
    if (url === '/ai/chat') {
      bodies.push(optionsArg.body);
      return bodies.length === 1 ? reply.promise : chatSuccess('new reply');
    }
    if (url === '/ai/memory' && optionsArg.method === 'DELETE') return { code: 0, data: { deleted: 2 } };
    return { code: 0, data: {} };
  });

  s.nodes.input.value = 'before clear';
  const sending = s.nodes['send'].emit('click');
  await flush();
  await s.action('clear');
  await s.findButton('确认清除').onclick();
  assert.equal(s.ui.state.turns.length, 0);

  reply.resolve(chatSuccess('late old reply'));
  await sending;
  await flush();
  s.nodes.input.value = 'after clear';
  await s.nodes['send'].emit('click');
  assert.equal(bodies[1].history.length, 0);
  assert.equal(bodies[1].remember, false);
});

test('P1-05 a failed clear keeps the visible turns and context', async () => {
  const bodies = [];
  const s = setup((url, optionsArg) => {
    if (url === '/ai/chat') {
      bodies.push(optionsArg.body);
      return chatSuccess('reply');
    }
    if (url === '/ai/memory' && optionsArg.method === 'DELETE') return { code: 50000, msg: '清除失败' };
    return { code: 0, data: {} };
  });

  s.nodes.input.value = 'keep me';
  await s.nodes['send'].emit('click');
  assert.equal(s.ui.state.turns.length, 2);
  await s.action('clear');
  await s.findButton('确认清除').onclick();
  assert.equal(s.ui.state.turns.length, 2);
  assert.match(s.nodes.chat.textContent, /keep me/);
  s.nodes.input.value = 'next';
  await s.nodes['send'].emit('click');
  assert.equal(bodies[1].history.length, 2);
});

test('P1-06 clear then immediate send is not blocked by the old pending request', async () => {
  const reply = deferred();
  const bodies = [];
  const s = setup((url, optionsArg) => {
    if (url === '/ai/chat') {
      bodies.push(optionsArg.body);
      return bodies.length === 1 ? reply.promise : chatSuccess('fresh');
    }
    if (url === '/ai/memory' && optionsArg.method === 'DELETE') return { code: 0, data: { deleted: 1 } };
    return { code: 0, data: {} };
  });

  s.nodes.input.value = 'old';
  const oldSend = s.nodes['send'].emit('click');
  await flush();
  await s.action('clear');
  await s.findButton('确认清除').onclick();
  s.nodes.input.value = 'fresh';
  await s.nodes['send'].emit('click');
  assert.equal(bodies.length, 2);
  assert.equal(bodies[1].history.length, 0);
  reply.resolve(chatSuccess('old reply'));
  await oldSend;
});

test('P1-07 account switch clears A data and sends B as temporary', async () => {
  const s = setup(url => {
    if (url === '/auth/me') return { code: 0, data: { user: { uid: 'A' } } };
    if (url === '/ai/messages') return historyEmpty;
    return chatSuccess('ok');
  }, { saved: true });
  await flush();
  assert.equal(s.ui.state.mode, 'saved');

  s.setAccount({ uid: 'B' }, 'token-B');
  s.nodes.input.value = 'B message';
  await s.nodes['send'].emit('click');
  assert.equal(s.ui.state.mode, 'temporary');
  assert.equal(s.ui.state.uid, 'B');
  assert.doesNotMatch(s.nodes.chat.textContent, /今天想从哪件小事说起/);
  assert.equal(s.calls.some(call => call.url === '/ai/chat'), false);

  await s.nodes['send'].emit('click');
  const chatCall = s.calls.find(call => call.url === '/ai/chat');
  assert.equal(chatCall.body.remember, false);
  assert.notEqual(s.storage.get('wg_ai_save_mode_B'), 'on');
});

test('P1-08 an old saved reply cannot repopulate after account switch', async () => {
  const reply = deferred();
  const s = setup(url => {
    if (url === '/auth/me') return { code: 0, data: { user: { uid: 'A' } } };
    if (url === '/ai/messages') return historyEmpty;
    if (url === '/ai/chat') return reply.promise;
    return { code: 0, data: {} };
  }, { saved: true });
  await flush();

  s.nodes.input.value = 'A private message';
  const sending = s.nodes['send'].emit('click');
  await flush();
  s.setAccount({ uid: 'B' }, 'token-B');
  s.emitStorage('wg_user');
  reply.resolve(chatSuccess('A old private reply'));
  await sending;
  await flush();
  assert.doesNotMatch(s.nodes.chat.textContent, /A old private reply/);
  assert.equal(s.ui.state.turns.length, 0);
  assert.equal(s.ui.state.mode, 'temporary');
});

test('P2-01 an old memory response cannot overwrite a successful clear', async () => {
  const memory = deferred();
  const s = setup((url, optionsArg) => {
    if (url === '/ai/memory' && optionsArg.method === 'DELETE') return { code: 0, data: { deleted: 2 } };
    if (url === '/ai/memory') return memory.promise;
    return { code: 0, data: {} };
  });

  await s.action('memory');
  await s.action('clear');
  await s.findButton('确认清除').onclick();
  assert.match(s.nodes['cc-panel-body'].textContent, /已清除 2/);
  memory.resolve({ code: 0, data: { hasMemory: true, summary: 'old sensitive summary', totalMessages: 2, pendingMessages: 0 } });
  await flush();
  assert.match(s.nodes['cc-panel-body'].textContent, /已清除 2/);
  assert.doesNotMatch(s.nodes['cc-panel-body'].textContent, /old sensitive summary/);
});

test('P2-02 closing the panel discards a pending memory response', async () => {
  const memory = deferred();
  const s = setup(url => (url === '/ai/memory' ? memory.promise : { code: 0, data: {} }));
  await s.action('memory');
  s.ui.closePanel();
  memory.resolve({ code: 0, data: { hasMemory: true, summary: 'must not appear' } });
  await flush();
  assert.equal(s.nodes['cc-panel-body'].textContent, '');
});

test('B2 prepare responses cannot replace a newer draft', async () => {
  const first = deferred();
  const second = deferred();
  const s = setup(url => {
    if (url === '/companion/prepare') return s.calls.filter(call => call.url === '/companion/prepare').length === 1 ? first.promise : second.promise;
    return { code: 0, data: {} };
  });
  await s.action('draft');
  s.ui.state.turns = [{ role: 'user', content: 'material' }];
  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];

  const statusA = new El('p');
  const statusB = new El('p');
  const requestA = s.ui.prepareDraft(new El('button'), { value: '2026-11-12' }, { checked: false }, statusA);
  const requestB = s.ui.prepareDraft(new El('button'), { value: '2026-11-13' }, { checked: false }, statusB);
  second.resolve({ code: 0, data: { draft: { id: 'newer', date: '2026-11-13', text: 'newer', status: 'pending', sources: [] }, trace: [] } });
  await requestB;
  assert.equal(s.ui.state.draft.id, 'newer');
  first.resolve({ code: 0, data: { draft: { id: 'older', date: '2026-11-12', text: 'older', status: 'pending', sources: [] }, trace: [] } });
  await requestA;
  assert.equal(s.ui.state.draft.id, 'newer');
  assert.match(s.nodes['cc-panel-body'].textContent, /2026-11-13/);
  assert.doesNotMatch(s.nodes['cc-panel-body'].textContent, /2026-11-12/);
});

test('B3 cancel is terminal and cannot submit a confirmation', async () => {
  let confirmPosts = 0;
  const s = setup((url, optionsArg) => {
    if (url === '/companion/prepare') {
      return { code: 0, data: { draft: { id: 'cancel-me', date: '2026-11-12', text: 'draft', status: 'pending', sources: [] }, trace: [] } };
    }
    if (url.endsWith('/confirm')) { confirmPosts += 1; return { code: 40900, msg: '草稿已取消' }; }
    if (url.startsWith('/companion/drafts/') && optionsArg.method === 'DELETE') {
      return { code: 0, data: { draft: { id: 'cancel-me', status: 'cancelled' } } };
    }
    return { code: 0, data: {} };
  });
  await s.action('draft');
  s.ui.state.turns = [{ role: 'user', content: 'material' }];
  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];
  await s.ui.prepareDraft(new El('button'), { value: '2026-11-12' }, { checked: false }, new El('p'));

  const status = new El('p');
  const confirmButton = s.findButton('确认保存为私密日记');
  const cancelButton = s.findButton('取消草稿');
  await s.ui.cancelDraft(cancelButton, status);
  assert.equal(s.ui.state.draftStatus, 'cancelled');
  assert.equal(confirmButton.disabled, true);
  await s.ui.confirmDraft(confirmButton, status, { value: 'draft' });
  assert.equal(confirmPosts, 0);
  assert.match(status.textContent, /已取消/);
  assert.doesNotMatch(status.textContent, /已有日记/);
});

test('B1 confirmation timeout retries the same draft id and renders real data', async () => {
  let posts = 0;
  const s = setup((url, optionsArg) => {
    if (url === '/companion/prepare') {
      return { code: 0, data: { draft: { id: 'retry-me', date: '2026-11-13', text: 'body', status: 'pending', sources: [] }, trace: [] } };
    }
    if (url.endsWith('/confirm')) {
      posts += 1;
      return posts === 1
        ? { code: -1 }
        : { code: 0, data: { diaryId: 42, date: '2026-11-13', url: 'diary-write.html?date=2026-11-13', status: 'confirmed', isPublic: false, care: null } };
    }
    return { code: 0, data: {} };
  });
  await s.action('draft');
  s.ui.state.turns = [{ role: 'user', content: 'material' }];
  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];
  await s.ui.prepareDraft(new El('button'), { value: '2026-11-13' }, { checked: false }, new El('p'));

  const confirmButton = s.findButton('确认保存为私密日记');
  await s.ui.confirmDraft(confirmButton, new El('p'), { value: 'body' });
  assert.equal(posts, 2);
  assert.match(s.nodes['cc-panel-body'].textContent, /42/);
  const link = s.nodes['cc-panel-body'].children.find(node => node.tag === 'a' && node.href === 'diary-write.html?date=2026-11-13');
  assert.ok(link);
  assert.equal(s.calls.some(call => call.url === '/companion/prepare' && call.method === 'POST'), true);
});

test('B4 crisis care is rendered inside the open panel with tel links', async () => {
  let confirmPosts = 0;
  const s = setup(url => {
    if (url === '/companion/prepare') {
      return { code: 0, data: { draft: null, care: { message: '请先联系可信任的人。', lines: [{ name: '心理援助热线', phone: '123-456' }] } } };
    }
    if (url.endsWith('/confirm')) { confirmPosts += 1; return { code: 0, data: {} }; }
    return { code: 0, data: {} };
  });
  await s.action('draft');
  s.ui.state.turns = [{ role: 'user', content: 'crisis material' }];
  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];
  await s.ui.prepareDraft(new El('button'), { value: '2026-11-13' }, { checked: false }, new El('p'));

  const panelText = s.nodes['cc-panel-body'].textContent;
  assert.match(panelText, /请先联系可信任的人/);
  assert.match(panelText, /心理援助热线/);
  assert.match(panelText, /123-456/);
  const tel = s.nodes['cc-panel-body'].children.some(node => node.tag === 'div' && node.children.some(child => child.href === 'tel:123-456'));
  assert.equal(tel, true);
  assert.equal(confirmPosts, 0);
  assert.equal(s.buttons().some(node => node.textContent.includes('确认保存')), false);
});
test('B3 error mapping separates cancellation, conflict, expiry and deleted diary', () => {
  const cancelled = companion.mapDraftError({ code: 40900, msg: '草稿已取消' });
  assert.equal(cancelled.cancelled, true);
  assert.equal(cancelled.conflict, undefined);
  assert.match(cancelled.message, /已取消/);
  const conflict = companion.mapDraftError({ code: 40900, msg: '这一天已有日记' });
  assert.equal(conflict.conflict, true);
  assert.match(conflict.message, /不会覆盖/);
  const expired = companion.mapDraftError({ code: 41000, msg: '草稿已过期' });
  assert.equal(expired.expired, true);
  const deleted = companion.mapDraftError({ code: 41000, msg: '已保存的日记不存在' });
  assert.equal(deleted.deleted, true);
  assert.match(deleted.message, /已被删除/);
});

test('P2-03 a failed clear keeps the server summary and explains the failure', async () => {
  const s = setup((url, optionsArg) => {
    if (url === '/ai/memory' && optionsArg.method === 'DELETE') return { code: 50000, msg: '清除失败' };
    if (url === '/ai/memory') return { code: 0, data: { hasMemory: true, summary: 'kept summary', totalMessages: 2, pendingMessages: 0 } };
    return { code: 0, data: {} };
  });
  await s.action('memory');
  assert.match(s.nodes['cc-panel-body'].textContent, /kept summary/);
  await s.action('clear');
  await s.findButton('确认清除').onclick();
  assert.match(s.nodes['cc-panel-body'].textContent, /清除失败/);
  assert.match(s.nodes['cc-panel-body'].textContent, /摘要仍然保留/);
  assert.doesNotMatch(s.nodes['cc-panel-body'].textContent, /已清除 0/);
});

