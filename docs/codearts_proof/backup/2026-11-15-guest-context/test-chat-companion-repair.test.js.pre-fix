});

test('EDGE-R5-01 confirm success shows full care inside the open dialog', async () => {
  const care = { message: 'synthetic crisis support', lines: [{ name: 'help line', phone: '12356' }] };
  const s = setup(url => {
    if (url === '/companion/prepare') {
      return { code: 0, data: { draft: { id: 'care-draft', date: '2026-11-13', text: 'body', status: 'pending', sources: [] } } };
    }
    if (url.endsWith('/confirm')) {
      return { code: 0, data: { diaryId: 10, date: '2026-11-13', url: 'diary-write.html?date=2026-11-13', isPublic: false, care } };
    }
    return { code: 0, data: {} };
  });
  await s.action('draft');
  s.ui.state.turns = [{ role: 'user', content: 'material' }];
  s.ui.renderDraftSelection();
  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];
  await s.findButton('生成草稿').onclick();
  await s.findButton('确认保存为私密日记').onclick();
  await flush();

  const panelText = s.nodes['cc-panel-body'].textContent;
  assert.match(panelText, /synthetic crisis support/);
  assert.match(panelText, /help line/);
  assert.match(panelText, /12356/);
  assert.equal(panelText.match(/synthetic crisis support/g).length, 1);
  const tel = s.nodes['cc-panel-body'].children.some(node => node.tag === 'div' && node.children.some(child => child.href === 'tel:12356'));
  assert.equal(tel, true);
  assert.equal(s.calls.filter(call => call.url.endsWith('/confirm')).length, 1);
});

