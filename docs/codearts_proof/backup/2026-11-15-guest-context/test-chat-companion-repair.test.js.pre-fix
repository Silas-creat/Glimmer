  s.setAccount({ uid: 'B' }, 'token-B');
  s.emitStorage('wg_user');
  s.nodes.input.value = 'B new conversation';
  await s.nodes['send'].emit('click');
  await flush();
  assert.match(s.nodes.chat.textContent, /B new conversation/);
  assert.equal(s.ui.state.uid, 'B');
  const turnsBefore = s.ui.state.turns.length;

  deletion.resolve({ code: 0, data: { deleted: 2 } });
