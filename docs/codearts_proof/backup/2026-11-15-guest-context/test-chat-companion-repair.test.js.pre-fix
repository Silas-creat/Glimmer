  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];
  await s.findButton('生成草稿').onclick();
  await flush();
  assert.equal(s.ui.state.draftStatus, 'pending');

  s.setAccount({ uid: 'A' }, 'token-A2');
  const pending = s.findButton('确认保存为私密日记').onclick();
  await flush();
  s.setAccount({ uid: 'B' }, 'token-B');
  s.emitStorage('wg_user');
  me.resolve({ code: 0, data: { user: { uid: 'A' } } });
  await pending;
  await flush();

  assert.equal(s.calls.filter(call => call.url.endsWith('/confirm')).length, 0);
  assert.doesNotMatch(s.nodes['cc-panel-body'].textContent, /已保存为私密日记|日记编号/);
  assert.match(s.nodes['cc-save-state'].textContent, /账号或登录状态已变化|操作已失效/);
});

test('EDGE-R7-05 a late auth response cannot cancel A draft on B credentials', async () => {
  const me = deferred();
  const s = setup(url => {
    if (url === '/auth/me') return me.promise;
    if (url === '/companion/prepare') {
      return { code: 0, data: { draft: { id: 'cancel-a', date: '2026-11-13', text: 'A cancel body', status: 'pending', sources: [] } } };
    }
    if (url.includes('/companion/drafts/') && url.endsWith('/confirm')) {
      return { code: 0, data: {} };
    }
    return { code: 0, data: {} };
  });
  await s.action('draft');
  s.ui.state.turns = [{ role: 'user', content: 'A cancel material' }];
  s.ui.renderDraftSelection();
  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];
  await s.findButton('生成草稿').onclick();
  await flush();

  s.setAccount({ uid: 'A' }, 'token-A2');
  const pending = s.findButton('取消草稿').onclick();
  await flush();
  s.setAccount({ uid: 'B' }, 'token-B');
  s.emitStorage('wg_user');
  me.resolve({ code: 0, data: { user: { uid: 'A' } } });
  await pending;
  await flush();

  assert.equal(s.calls.filter(call => call.method === 'DELETE').length, 0);
  assert.doesNotMatch(s.nodes['cc-panel-body'].textContent, /草稿已取消/);
  assert.match(s.nodes['cc-save-state'].textContent, /账号或登录状态已变化|操作已失效/);
});

test('EDGE-R7-06 a late auth response cannot send A text on B credentials', async () => {
  const me = deferred();
  const s = setup(url => {
    if (url === '/auth/me') return me.promise;
    if (url === '/ai/chat') return chatSuccess('A secret reply');
    return { code: 0, data: {} };
  });
  s.nodes.input.value = 'A synthetic private text';
  s.setAccount({ uid: 'A' }, 'token-A2');
  const pending = s.nodes['send'].emit('click');
  await flush();
  s.setAccount({ uid: 'B' }, 'token-B');
  s.emitStorage('wg_user');
  me.resolve({ code: 0, data: { user: { uid: 'A' } } });
  await pending;
  await flush();

  assert.equal(s.calls.filter(call => call.url === '/ai/chat').length, 0);
  assert.doesNotMatch(s.nodes.chat.textContent, /A synthetic private text|A secret reply/);
  assert.equal(s.nodes['send'].disabled, false);
  assert.equal(s.ui.state.sending, false);
});

test('EDGE-R7-07 a late restore verification cannot write A history into B page', async () => {
  const me = deferred();
  const s = setup(url => {
    if (url === '/auth/me') return me.promise;
    if (url === '/ai/messages') return { code: 0, data: { list: [{ role: 'user', content: 'A restored history' }], hasMore: false } };
    return { code: 0, data: {} };
  }, { saved: true });
  await flush();

  s.setAccount({ uid: 'B' }, 'token-B');
  s.emitStorage('wg_user');
  me.resolve({ code: 0, data: { user: { uid: 'A', nickname: 'synthetic' } } });
  await flush();

  assert.equal(s.ui.state.uid, 'B');
  assert.doesNotMatch(s.nodes.chat.textContent, /A restored history/);
  assert.equal(s.calls.filter(call => call.url === '/ai/messages').length, 0);
});

test('EDGE-R7-08 a verification that outlives a second token refresh cannot prepare', async () => {
  const me = deferred();
  const s = setup(url => {
    if (url === '/auth/me') return me.promise;
    if (url === '/companion/prepare') {
      return { code: 0, data: { draft: { id: 'stale-a', date: '2026-11-13', text: 'stale draft', status: 'pending', sources: [] } } };
    }
    return { code: 0, data: {} };
  });
  await s.action('draft');
  s.ui.state.turns = [{ role: 'user', content: 'A stale material' }];
  s.ui.renderDraftSelection();
  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];

  s.setAccount({ uid: 'A' }, 'token-A2');
  const pending = s.findButton('生成草稿').onclick();
  await flush();
  s.setAccount({ uid: 'A' }, 'token-A3');
  me.resolve({ code: 0, data: { user: { uid: 'A' } } });
  await pending;
  await flush();

  assert.equal(s.calls.filter(call => call.url === '/companion/prepare').length, 0);
  assert.equal(s.ui.state.draft, null);
  assert.equal(s.ui.state.draftMaterial === null || s.ui.state.draftMaterial.uid !== 'A', true);
});

test('EDGE-R7-09 a late prepare response cannot land after the panel is closed', async () => {
  const prepare = deferred();
  const s = setup(url => {
    if (url === '/companion/prepare') return prepare.promise;
    return { code: 0, data: {} };
  });
  await s.action('draft');
  s.ui.state.turns = [{ role: 'user', content: 'A closed-late material' }];
  s.ui.renderDraftSelection();
  s.nodes['cc-panel-body'].querySelectorAll = () => [{ value: '0' }];

  const pending = s.findButton('生成草稿').onclick();
  await flush();
  s.ui.closePanel();
  prepare.resolve({ code: 0, data: { draft: { id: 'late-draft', date: '2026-11-13', text: 'late body', status: 'pending', sources: [] } } });
  await pending;
  await flush();

  assert.equal(s.ui.state.draft, null);
  assert.doesNotMatch(s.nodes['cc-panel-body'].textContent, /late body|尚未保存为日记/);
});

test('EDGE-R8-01 a guest can send a temporary unsaved chat without verification', async () => {
  const s = setup(url => {
    if (url === '/ai/chat') return chatSuccess('guest reply');
    return { code: 0, data: {} };
  }, { user: {}, token: '' });
  s.nodes.input.value = 'guest synthetic message';
  await s.nodes['send'].emit('click');
  await flush();

  const chats = s.calls.filter(call => call.url === '/ai/chat');
  assert.equal(chats.length, 1);
  assert.equal(chats[0].body.remember, false);
  assert.match(s.nodes.chat.textContent, /guest reply/);
  assert.equal(s.calls.some(call => call.url === '/auth/me'), false);
  assert.match(s.nodes['cc-save-state'].textContent, /临时|未保存/);
});

test('EDGE-R8-02 a guest refresh clears anonymous turns and can send again', async () => {
  const handler = url => (url === '/ai/chat' ? chatSuccess('guest reply') : { code: 0, data: {} });
  const first = setup(handler, { user: {}, token: '' });
  first.nodes.input.value = 'first guest message';
  await first.nodes['send'].emit('click');
  await flush();
  assert.equal(first.calls.filter(call => call.url === '/ai/chat').length, 1);

  const refreshed = setup(handler, { user: {}, token: '' });
  assert.equal(refreshed.ui.state.turns.length, 0);
  assert.match(refreshed.nodes.chat.textContent, /今天想从哪件小事说起/);
  assert.equal(refreshed.calls.some(call => call.url === '/ai/messages'), false);
  assert.equal(refreshed.calls.some(call => call.url === '/ai/memory'), false);

  refreshed.nodes.input.value = 'second guest message';
  await refreshed.nodes['send'].emit('click');
  await flush();
  const chats = refreshed.calls.filter(call => call.url === '/ai/chat');
  assert.equal(chats.length, 1);
  assert.equal(chats[0].body.remember, false);
});

test('EDGE-R8-03 a guest cannot enable saved mode', async () => {
  const s = setup(url => ({ code: 0, data: {} }), { user: {}, token: '' });
  s.nodes['cc-save-toggle'].checked = true;
  await s.nodes['cc-save-toggle'].emit('change');
  await flush();

  assert.equal(s.ui.state.mode, 'temporary');
  assert.equal(Array.from(s.storage.keys()).some(key => key.startsWith('wg_ai_save_mode_')), false);
  assert.match(s.nodes['cc-save-state'].textContent, /登录后才能保存对话记忆/);
});

test('EDGE-R8-04 a guest history memory draft entry asks for login without data', async () => {
  const s = setup(url => ({ code: 0, data: { list: [], hasMore: false, hasMemory: true, summary: 'should not load' } }), { user: {}, token: '' });
  await s.action('history');
  await flush();
  await s.action('memory');
  await flush();
  await s.action('draft');
  await flush();

  assert.equal(s.ui.state.historyItems.length, 0);
  assert.equal(s.ui.state.memorySnapshot, null);
  assert.equal(s.ui.state.draft, null);
  assert.doesNotMatch(s.nodes['cc-panel-body'].textContent, /should not load/);
  assert.match(s.nodes['cc-panel-body'].textContent, /登录/);
  assert.equal(s.findButton('生成草稿'), undefined);
});

test('EDGE-R8-05 token removal isolates A context before a guest send', async () => {
  const s = setup(url => (url === '/ai/chat' ? chatSuccess('guest after logout') : { code: 0, data: {} }));
  s.ui.state.turns = [{ role: 'user', content: 'A synthetic bubble' }];
  s.nodes.chat.textContent = 'A synthetic bubble';
  s.setAccount({ uid: 'A' }, '');
  s.emitStorage('wg_token');
  await flush();

  assert.doesNotMatch(s.nodes.chat.textContent, /A synthetic bubble/);
  assert.equal(s.ui.state.uid, '');
  assert.equal(s.ui.state.mode, 'temporary');

  s.nodes.input.value = 'guest after logout message';
  await s.nodes['send'].emit('click');
  await flush();
  const chats = s.calls.filter(call => call.url === '/ai/chat');
  assert.equal(chats.length, 1);
  assert.equal(chats[0].body.remember, false);
});

test('EDGE-R8-06 logout clears draft and memory then allows guest send', async () => {
  const s = setup(url => (url === '/ai/chat' ? chatSuccess('guest after exit') : { code: 0, data: {} }));
  s.ui.state.turns = [{ role: 'user', content: 'A exiting bubble' }];
  s.nodes.chat.textContent = 'A exiting bubble';
  s.ui.state.draft = { id: 'draft-a', text: 'A exiting draft', status: 'pending' };
  s.ui.state.memorySnapshot = { hasMemory: true, summary: 'A exiting summary' };
  s.setAccount(null, '');
  s.emitStorage('wg_user');
  await flush();

  assert.equal(s.ui.state.draft, null);
  assert.equal(s.ui.state.memorySnapshot, null);
  assert.doesNotMatch(s.nodes.chat.textContent, /A exiting bubble/);

  s.nodes.input.value = 'guest after exit message';
  await s.nodes['send'].emit('click');
  await flush();
  const chats = s.calls.filter(call => call.url === '/ai/chat');
  assert.equal(chats.length, 1);
  assert.equal(chats[0].body.remember, false);
});

test('EDGE-R8-07 an old signed-in reply cannot land after logout', async () => {
  const reply = deferred();
  const s = setup(url => (url === '/ai/chat' ? reply.promise : { code: 0, data: {} }));
  s.nodes.input.value = 'A in-flight text';
  const sending = s.nodes['send'].emit('click');
  await flush();
  s.setAccount(null, '');
  s.emitStorage('wg_user');
  reply.resolve(chatSuccess('A secret in-flight reply'));
  await sending;
  await flush();

  assert.doesNotMatch(s.nodes.chat.textContent, /A secret in-flight reply/);
  assert.equal(s.nodes.input.value, '');
  assert.equal(s.nodes['send'].disabled, false);
});

test('EDGE-R8-08 guest-to-login does not reuse anonymous content or enable saving', async () => {
  const s = setup(url => ({ code: 0, data: {} }), { user: {}, token: '' });
  s.ui.state.turns = [{ role: 'user', content: 'anonymous content' }];
  s.nodes.chat.textContent = 'anonymous content';
  s.setAccount({ uid: 'A' }, 'token-A');
  s.emitStorage('wg_user');
  await flush();

  assert.doesNotMatch(s.nodes.chat.textContent, /anonymous content/);
  assert.equal(s.ui.state.mode, 'temporary');
  assert.equal(s.storage.has('wg_ai_save_mode_A'), false);
  assert.equal(s.calls.some(call => call.url === '/ai/chat' && call.body && call.body.remember === true), false);
});

test('EDGE-R8-09 a guest double click sends only one request', async () => {
  const reply = deferred();
  let chatCount = 0;
  const s = setup(url => {
    if (url === '/ai/chat') { chatCount += 1; return reply.promise; }
    return { code: 0, data: {} };
  }, { user: {}, token: '' });
  s.nodes.input.value = 'guest double click';
  const first = s.nodes['send'].emit('click');
  const second = s.nodes['send'].emit('click');
  await flush();

  assert.equal(chatCount, 1);
  assert.equal(s.ui.state.turns.filter(turn => turn.role === 'user').length, 1);

  reply.resolve(chatSuccess('guest single reply'));
  await Promise.all([first, second]);
  await flush();
  assert.equal(s.nodes['send'].disabled, false);
});

test('EDGE-R8-10 a failed guest send keeps the text and writes no history', async () => {
  const s = setup(url => (url === '/ai/chat' ? { code: 50000, msg: 'guest failure' } : { code: 0, data: {} }), { user: {}, token: '' });
  s.nodes.input.value = 'guest failing text';
  await s.nodes['send'].emit('click');
  await flush();

  assert.equal(s.calls.filter(call => call.url === '/ai/chat').length, 1);
  assert.equal(s.calls.some(call => call.url === '/ai/messages'), false);
  assert.equal(s.calls.some(call => call.url === '/ai/memory'), false);
  assert.equal(s.calls.some(call => call.url.startsWith('/companion/')), false);
  assert.equal(Array.from(s.storage.keys()).some(key => key.startsWith('wg_ai_save_mode_')), false);
  assert.equal(s.nodes.input.value, 'guest failing text');
});