# ---- 依赖 ----
node_modules/
**/node_modules/

# ---- 环境变量与密钥（只保留模板）----
.env
.env.local
.env.*.local
**/.env
!**/.env.example

# ---- 运行时与日志 ----
*.log
**/*.log
.runtime/

# ---- 上传目录（运行时生成，保留占位文件）----
后端源码/uploads/*
!后端源码/uploads/.gitkeep

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
