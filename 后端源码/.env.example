# ===== 复制这个文件为 .env，然后按实际情况改 =====
# cp .env.example .env

# ---- 服务监听 ----
# 0.0.0.0 表示允许局域网/宿主机访问（虚拟机里必须这样，否则宿主机连不上）
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# ---- MySQL ----
# 后端和 MySQL 在同一台虚拟机上，所以是 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=这里填你的MySQL密码
DB_NAME=peizhe

# ---- JWT 登录令牌 ----
# 一定要改成你自己的随机长字符串！泄露等于别人能伪造登录
JWT_SECRET=换成你自己的随机字符串_越长越好_abc123xyz
JWT_EXPIRES_IN=30d

# ---- DeepSeek AI ----
DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ---- 验证码（开发期）----
# 万能码：任何手机号输入这个码都能登录，方便自己测试
DEV_SMS_CODE=123456
# 真实发短信开关，先关着
SMS_ENABLED=false

# ---- 对外地址（拼头像等图片的完整 URL 用）----
# 前端和后端不在同一个源时（前端是 file:// 或别的端口），
# 数据库里只存 /uploads/x.jpg 这样的相对路径，浏览器会解析到前端自己的目录，
# 图片就显示不出来。所以要把图片字段拼成完整 URL 再返回。
# 上线后改成你的域名，比如 https://api.peizhe.com
# 不填的话按 http://PUBLIC_HOST:PORT 自动拼
# PUBLIC_BASE_URL=
# PUBLIC_HOST=127.0.0.1
